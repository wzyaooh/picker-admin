# ==========================================
# Application Configuration
# ==========================================

# 应用端口
APP_PORT=8085

# 运行环境: development | production | test
NODE_ENV=development

# ==========================================
# Database Configuration (MySQL)
# ==========================================

# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码（请修改为强密码）
DB_PWD=your_database_password_here

# 数据库名称
DB_DATABASE=pick-admin

# 是否开启数据库同步 (生产环境必须设置为 false)
# 警告: 开启后会自动同步数据库结构，可能导致数据丢失
DB_SYNC=false

# ==========================================
# Redis Configuration
# ==========================================

# Redis 连接 URL
# 格式: redis://[username]:[password]@[host]:[port]/[db]
# 如果 Redis 没有密码，使用: redis://localhost:6379/0
# 如果 Redis 有密码，使用: redis://default:your_password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ==========================================
# JWT Configuration
# ==========================================

# JWT 密钥 (生产环境请使用强密码，建议 32 位以上随机字符串)
# 可以使用以下命令生成: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# JWT 过期时间 (可选，默认值在代码中设置)
# 示例: 7d (7天), 24h (24小时), 3600 (3600秒)
# JWT_EXPIRES_IN=7d

# ==========================================
# CORS Configuration
# ==========================================

# 允许的跨域来源 (多个用逗号分隔)
# 示例: http://localhost:5173,http://localhost:5174,https://example.com
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ==========================================
# Swagger API Documentation
# ==========================================

# 是否启用 Swagger 文档 (生产环境建议设置为 false)
SWAGGER_ENABLED=true

# Swagger 文档访问路径
SWAGGER_PATH=docs

# ==========================================
# Logging Configuration
# ==========================================

# 日志级别: error | warn | info | debug | verbose
LOG_LEVEL=info

# 日志目录
LOG_DIR=logs

# 是否启用控制台日志输出
LOG_CONSOLE=true

# ==========================================
# Preview Environment
# ==========================================

# 是否为预览环境
IS_PREVIEW=false

# ==========================================
# File Upload Configuration
# ==========================================

# 文件上传最大大小（字节）
# 默认: 104857600 (100MB)
FILE_MAX_SIZE=104857600

# 单次最多上传文件数量
FILE_MAX_COUNT=10

# 上传速率限制 - 时间窗口（毫秒）
UPLOAD_RATE_WINDOW=60000

# 上传速率限制 - 时间窗口内最大上传次数
UPLOAD_RATE_LIMIT=20

# 文件上传目录
FILE_UPLOAD_DIR=./uploads

# 文件访问基础 URL
FILE_BASE_URL=http://localhost:8085

# ==========================================
# Security Configuration
# ==========================================

# 注意：密码策略、账号锁定、审计日志等安全配置存储在数据库中，
# 通过后台管理界面（系统管理 -> 安全配置）进行配置，不在此文件中设置。
# 
# 以下配置仅用于审计日志的全局开关：

# 是否启用审计日志（全局开关）
AUDIT_ENABLED=true

# 是否保存请求体到审计日志（全局开关，具体接口可通过 @Audit 装饰器覆盖）
AUDIT_SAVE_BODY=false
