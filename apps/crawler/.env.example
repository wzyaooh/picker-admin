# ==========================================
# Flask Configuration
# ==========================================

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# ==========================================
# MongoDB Configuration
# ==========================================

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=your_mongodb_password_here
MONGO_AUTH_SOURCE=admin
MONGO_DB=crawler_db

# ==========================================
# Redis Configuration (shared with backend)
# ==========================================

# 方式 1：使用 REDIS_URL（推荐）
# 无密码: redis://localhost:6379/1
# 有密码: redis://default:your_password@localhost:6379/1
REDIS_URL=redis://localhost:6379/1

# 方式 2：使用单独配置
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=1
# REDIS_PASSWORD=your_redis_password_here

# ==========================================
# MySQL Configuration (shared with backend)
# ==========================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=pick-admin

# ==========================================
# Crawler Settings
# ==========================================

# 并发爬取数量
CRAWLER_CONCURRENT=5

# 请求延迟（秒）
CRAWLER_DELAY=1.0

# 请求超时（秒）
CRAWLER_TIMEOUT=30

# 重试次数
CRAWLER_RETRY=3

# ==========================================
# Web Search Settings
# ==========================================

WEB_SEARCH_TIMEOUT=20
WEB_SEARCH_MAX_RETRIES=2

# HTTP 代理（可选，如果需要使用代理）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# ==========================================
# Anthropic (Claude LLM) Configuration
# ==========================================

# Anthropic API Key（必填）
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API Base URL（可选，使用第三方代理时填写）
# 官方地址: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 使用的模型
ANTHROPIC_MODEL=claude-sonnet-4-6

# 最大 Token 数
ANTHROPIC_MAX_TOKENS=128000
ANTHROPIC_ARTICLE_MAX_TOKENS=64000

# ==========================================
# Backend API Configuration
# ==========================================

# 后端 API 地址（用于记录使用统计）
BACKEND_URL=http://localhost:8085

# ==========================================
# GitHub Token (Optional)
# ==========================================

# GitHub Personal Access Token（可选，用于 GitHub 相关爬虫）
# 获取地址: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_token_here
