# ==========================================
# Application Configuration
# ==========================================

# 应用标题
VITE_APP_TITLE=Picker Admin

# 端口号
VITE_PORT=5888

# 基础路径
VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否打开 devtools
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# ==========================================
# Router Configuration
# ==========================================

# 路由模式配置
# frontend: 使用前端定义的静态路由（routes/modules/*.ts）
# backend: 使用后端返回的动态路由（从数据库加载）
# 默认值: backend
VITE_ACCESS_MODE=backend
